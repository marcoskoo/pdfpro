{
  "name": "pdfpro",
  "productName": "PDFPro",
  "version": "2.9.9",
  "description": "PDFPro — PDF Editor Pro (CORPAC AIS/ARO SPHI), versión de escritorio para Windows",
  "author": "CORPAC AIS/ARO SPHI",
  "license": "Propietario",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "pe.gob.corpac.pdfpro",
    "productName": "PDFPro",
    "copyright": "Copyright © 2026 CORPAC AIS/ARO SPHI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "es",
      "en-US"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PDFPro-Portable-${version}.${ext}",
      "unicode": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDFPro",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PDFPro-Setup-${version}.${ext}",
      "script": "installer.nsi"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "description": "Documento PDF",
        "role": "Viewer",
        "icon": "build/pdfdoc.ico"
      }
    ]
  }
}